# AWS Environment Variables Template
# Copy this file and fill in the values, then store in AWS Secrets Manager

# ============================================
# Database (RDS PostgreSQL)
# ============================================
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@optileno-db-prod.xxxxx.us-east-1.rds.amazonaws.com:5432/optileno

# ============================================
# Cache (ElastiCache Redis)
# ============================================
REDIS_URL=redis://optileno-redis.xxxxx.ng.0001.use1.cache.amazonaws.com:6379/0

# ============================================
# Application Security
# ============================================
# Generate a strong secret key:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-here-minimum-32-characters

# ============================================
# Environment
# ============================================
ENVIRONMENT=production
DEBUG=false

# ============================================
# Frontend URLs (for CORS)
# ============================================
# These should match your domain
FRONTEND_URL=https://yourdomain.com
PRODUCTION_FRONTEND_URL=https://yourdomain.com
APP_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================
# Cookie Settings
# ============================================
COOKIE_SECURE=true
COOKIE_SAMESITE=none
COOKIE_DOMAIN=yourdomain.com

# ============================================
# AI Providers (Choose one or more)
# ============================================
AI_PROVIDER=groq
AI_MODEL=mixtral-8x7b-32768

# GROQ API (Recommended - Free tier available)
GROQ_API_KEY=gsk_your_groq_api_key_here

# NVIDIA NIM (Alternative)
NVIDIA_API_KEY=nvapi-your-nvidia-key-here
NVIDIA_BRAIN_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_AGENT_MODEL=meta/llama-3.3-70b-instruct

# OpenAI (Optional)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo

# Gemini (Optional)
GEMINI_API_KEY=your-gemini-api-key-here

# ============================================
# Owner Account (Auto-provisioned)
# ============================================
OWNER_EMAIL=your-admin-email@example.com
# Generate a bcrypt hash with:
# python -c "from passlib.context import CryptContext; pwd_context = CryptContext(schemes=['bcrypt'], deprecated='auto'); print(pwd_context.hash('your_password'))"
OWNER_PASSWORD_HASH=$2b$12$hashed_password_here

# ============================================
# Database Performance Tuning
# ============================================
# RDS t3.micro: 1 vCPU, 1 GB RAM
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
DB_STATEMENT_TIMEOUT=30000

# ============================================
# Worker Configuration (Uvicorn)
# ============================================
# For t3.micro Fargate (512 CPU, 1GB RAM): 2-4 workers
WORKERS_PER_CORE=2
MAX_WORKERS=4
WEB_CONCURRENCY=4
UVICORN_BACKLOG=2048
UVICORN_TIMEOUT_KEEP_ALIVE=10
UVICORN_LIMIT_CONCURRENCY=500

# ============================================
# Payments (Optional)
# ============================================
STRIPE_API_KEY=sk_live_your_stripe_key_here

# ============================================
# Logging
# ============================================
ENABLE_DOCS=false
LOG_LEVEL=info

# ============================================
# Session Management
# ============================================
MAX_CONCURRENT_SESSIONS=5
SESSION_TIMEOUT_MINUTES=60

# ============================================
# Security
# ============================================
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
PASSWORD_MIN_LENGTH=8
MFA_ENABLED=true

# ============================================
# AWS-Specific Configuration
# ============================================
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=YOUR_AWS_ACCOUNT_ID
