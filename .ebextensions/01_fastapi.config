option_settings:
  aws:elasticbeanstalk:application:environment:
    PYTHONPATH: "/var/app/current"
    PYTHONUNBUFFERED: "1"
    PORT: "5000"
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: "/health"
    Port: "5000"
    Protocol: "HTTP"
    DeregistrationDelay: "20"
  aws:elasticbeanstalk:command:
    Timeout: "600"
