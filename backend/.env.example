# 🔐 OPTILENO - Local Development Environment Template
# Copy this file to backend/.env and fill in your actual values.

# ==========================================
# APPLICATION
# ==========================================
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
BASE_URL=http://localhost:8000

# ==========================================
# SECURITY
# ==========================================
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
EXPOSE_DEBUG_AUTH_TOKENS=false

# Auth endpoint rate limiting (Redis-backed with in-memory fallback)
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_LOGIN_IP_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_LOGIN_IDENTIFIER_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_REGISTER_IP_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_REGISTER_IDENTIFIER_MAX_ATTEMPTS=5

# ==========================================
# DATABASE
# ==========================================
DATABASE_URL=sqlite+aiosqlite:///./data/concierge.db
# For PostgreSQL local development:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/optileno

# ==========================================
# AI PROVIDERS
# ==========================================
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-pro

# Get from: https://aistudio.google.com/app/apikeys
GEMINI_API_KEY=your_gemini_api_key_here

# Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Get from: https://platform.openai.com/api-keys (optional backup)
OPENAI_API_KEY=your_openai_api_key_here

# ==========================================
# PAYMENTS (STRIPE)
# ==========================================
STRIPE_API_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRO_PRICE_ID=price_your_price_id

# ==========================================
# FRONTEND
# ==========================================
FRONTEND_URL=http://localhost:3000
PRODUCTION_FRONTEND_URL=https://your-production-frontend.com

# ==========================================
# CORS
# ==========================================
# Never use * when credentials/cookies are enabled.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ==========================================
# FEATURES
# ==========================================
ENABLE_DOCS=true

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# ==========================================
# GMAIL OUTREACH BOT CONFIG
# ==========================================
OUTREACH_GMAIL_USER=your_email@gmail.com
OUTREACH_GMAIL_APP_PASSWORD=your_gmail_app_password

